EVENTHARBOR_ENVIRONMENT=local
EVENTHARBOR_DATABASE_URL=postgresql+asyncpg://eventharbor:eventharbor@postgres:5432/eventharbor
EVENTHARBOR_DATABASE_SSL_MODE=disable
EVENTHARBOR_READINESS_TIMEOUT_SECONDS=3
EVENTHARBOR_RECEIVER_LAB_URL=http://receiver-lab:8100/webhooks
EVENTHARBOR_RECEIVER_LAB_CONTROL_URL=http://receiver-lab:8100
EVENTHARBOR_WORKER_POLL_INTERVAL_SECONDS=0.5
EVENTHARBOR_WORKER_HTTP_TIMEOUT_SECONDS=5
EVENTHARBOR_WORKER_LEASE_SECONDS=30
# Local demo policy: intentionally accelerated for interactive feedback.
# Production defaults are 8 attempts, 10s base, 3600s max, and 3600s cap.
EVENTHARBOR_WORKER_MAX_ATTEMPTS=4
EVENTHARBOR_WORKER_BASE_DELAY_SECONDS=1
EVENTHARBOR_WORKER_MAX_DELAY_SECONDS=2
EVENTHARBOR_WORKER_RETRY_AFTER_CAP_SECONDS=5
EVENTHARBOR_RETENTION_DAYS=7
EVENTHARBOR_RETENTION_BATCH_SIZE=500
EVENTHARBOR_RETENTION_MAX_EVENTS_PER_RUN=5000
EVENTHARBOR_LOG_LEVEL=INFO

POSTGRES_DB=eventharbor
POSTGRES_USER=eventharbor
POSTGRES_PASSWORD=eventharbor
POSTGRES_PORT=5432
FRONTEND_PORT=3000
