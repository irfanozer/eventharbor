# Copy to /etc/eventharbor/runtime.env as root:root, mode 0600.
# Raw KEY=value only. Do not quote values; percent-encode reserved URL characters.
# Use the VM's Azure DNS hostname for pre-cutover HTTPS, then the custom hostname.
PUBLIC_HOSTNAME=eventharbor.example.com
ACME_EMAIL=operator@example.com
# Verified official Docker Hub 2-alpine index digest on 2026-09-28 (2.11.4).
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
# Dedicated database and restricted application role on the shared private server.
EVENTHARBOR_DATABASE_URL=postgresql+asyncpg://eventharbor_app:REPLACE_PERCENT_ENCODED_PASSWORD@REPLACE.postgres.database.azure.com:5432/eventharbor?ssl=verify-full
# BACKEND_IMAGE and FRONTEND_IMAGE are supplied as deploy.sh arguments.
